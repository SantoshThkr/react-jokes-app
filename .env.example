# Used by docker-compose.yml. Copy to .env and fill in real values.
# The .env file is git-ignored; never commit it.

POSTGRES_USER=ops
POSTGRES_PASSWORD=
POSTGRES_DB=ops_dashboard

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Host ports
WEB_PORT=8080
DB_PORT=5433
