{
  "name": "ops-dashboard-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST + Socket.IO API for the Real-Time Operations Dashboard",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "user:set-role": "tsx src/scripts/setUserRole.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "tsx": "^4.23.15",
    "typescript": "~5.8",
    "typescript-eslint": "^8.70.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
