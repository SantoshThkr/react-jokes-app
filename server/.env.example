# Runtime environment: development | test | production
NODE_ENV=development

# Port the API and Socket.IO server listen on
PORT=4000

# Allowed browser origin(s) for CORS and Socket.IO, comma separated
CLIENT_URL=http://localhost:5173

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string
DATABASE_URL=postgresql://ops:ops_dev_password@localhost:5433/ops_dashboard?schema=public

# Secret used to sign JWTs. At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Token lifetime, e.g. 15m, 8h, 1d
JWT_EXPIRES_IN=8h

# bcrypt cost factor (4-15). 12 is a sensible production default.
BCRYPT_ROUNDS=12

# Login/register attempts allowed per IP per window
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
